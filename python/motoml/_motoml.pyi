from collections.abc import Callable, Iterable, Mapping
from typing import Any, Literal

type ParseMode = Literal["strict", "trusted"]

class NativeDocument:
    def node_kind(self, node_idx: int, /) -> str: ...
    def node_len(self, node_idx: int, /) -> int: ...
    def table_get_idx(self, node_idx: int, key: str, /) -> int: ...
    def array_get_idx(self, node_idx: int, index: int, /) -> int: ...
    def table_keys(self, node_idx: int, /) -> list[str]: ...
    def node_to_py(self, node_idx: int, /) -> Any: ...
    def node_to_json(self, node_idx: int, /) -> str: ...

class NativeGpuParser:
    def __init__(
        self,
        initial_capacity_bytes: int = ...,
        min_gpu_bytes: int = ...,
    ) -> None: ...
    def has_unified_memory(self, /) -> bool: ...
    def warmup(self, strict: bool, /) -> None: ...
    def parse(
        self,
        data: str | bytes | bytearray,
        force_gpu: bool,
        gpu_materialize: bool,
        /,
    ) -> NativeDocument: ...
    def parse_file(
        self, path: str, force_gpu: bool, /
    ) -> NativeDocument: ...
    def loads(
        self, data: str | bytes | bytearray, force_gpu: bool, /
    ) -> dict[str, Any]: ...
    def load_file(
        self, path: str, force_gpu: bool, /
    ) -> dict[str, Any]: ...
    def parse_batch(
        self, docs: Iterable[str | bytes | bytearray], force_gpu: bool, /
    ) -> list[NativeDocument]: ...
    def to_tagged_json(
        self, data: str | bytes | bytearray, force_gpu: bool, /
    ) -> str: ...

def _set_decode_error_type(exc_cls: type[ValueError], /) -> None: ...
def has_gpu() -> bool: ...
def loads(
    data: str | bytes | bytearray,
    parse_float: Callable[[str], Any] | None,
    mode: ParseMode,
    /,
) -> dict[str, Any]: ...
def load_file(
    path: str,
    parse_float: Callable[[str], Any] | None,
    mode: ParseMode,
    /,
) -> dict[str, Any]: ...
def parse(data: str | bytes | bytearray, /) -> NativeDocument: ...
def parse_file(path: str, /) -> NativeDocument: ...
def validate(
    data: str | bytes | bytearray, mode: ParseMode, /
) -> None: ...
def to_tagged_json(
    data: str | bytes | bytearray, mode: ParseMode, /
) -> str: ...
def dumps(obj: Mapping[str, Any], /) -> str: ...
